# Environment stage ('development' or 'production')
ENVIRONMENT=development

# Qdrant vector store configuration
# Set QDRANT_MODE to 'local' for local Docker Qdrant or 'cloud' for Qdrant Cloud
QDRANT_MODE=local
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=docmind_docs

# Qdrant Cloud configuration (Required only when QDRANT_MODE=cloud)
QDRANT_CLOUD_URL=https://your-cluster-id.qdrant.io
QDRANT_API_KEY=your_qdrant_cloud_api_key_here

# Ingestion configuration
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# LLM Configuration
# Mode selection: 'ollama' for local inference, 'groq' for cloud API (Groq is default for production cloud deployment)
LLM_MODE=ollama

# Local Ollama Settings
LOCAL_LLM_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434

# Cloud Groq Settings (Get free API key from https://console.groq.com)
GROQ_API_KEY=gsk_your_api_key_here

# Default retrieval top_k limit
DEFAULT_TOP_K=3
